---
const adminUrl = "/_emdash/admin";
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>NorTh メニュー管理 | EmDash</title>
    <style>
      body{font-family:-apple-system,BlinkMacSystemFont,"Hiragino Kaku Gothic ProN","Yu Gothic",Meiryo,sans-serif;max-width:760px;margin:80px auto;padding:24px;line-height:1.8}
      a{display:inline-block;padding:12px 18px;border-radius:999px;background:#e85d2a;color:#fff;text-decoration:none;font-weight:700}
      .box{padding:28px;border:1px solid #ddd;border-radius:18px;background:#fffaf2}
    </style>
  </head>
  <body>
    <div class="box">
      <h1>NorTh ノース メニュー管理</h1>
      <p>EmDashで料理名・価格・説明・表示順を管理します。</p>
      <p><a href={adminUrl}>EmDash管理画面を開く</a></p>
    </div>
  </body>
</html>
