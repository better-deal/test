{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "north-emdash",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "north-emdash",
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "north-emdash-media",
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
